# 中文镜像的构建依赖。
#
# 注意：上游仓库根目录的 Gemfile 只声明了 `github-pages`（对应 Jekyll 3.9），
# 与本站点使用的 Jekyll 4 不兼容，因此中文镜像单独声明依赖。
# CI 与本地构建都应在本目录（translations/zh_CN）下执行。
source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# 构建时解析 HTML，统一处理导航、正文和静态资源中的站内链接。
gem "nokogiri", "~> 1.18"

# Ruby 3.0 起不再内置 webrick，本地执行 `jekyll serve` 需要它。
gem "webrick", "~> 1.9"
